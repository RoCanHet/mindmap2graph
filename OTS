        P0_Conflict -->|Không| P0_Lock["🔒 KHÓA Timeline Khảo thí<br/>- Blockchain log timestamp<br/>- Version control<br/>- Digital signature Admin"]
        
        P0_Lock --> P0_Notify["Thông báo Timeline tới tất cả bên liên quan:<br/>→ CMS: Đăng thông báo chính thức<br/>→ Email: PDT, BM, Trưởng khoa<br/>→ Dashboard: Hiển thị countdown"]
    end


    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    %% PHASE 1: PHÂN CÔNG RA ĐỀ & BỘ MÔN DUYỆT
    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    P0_Notify --> P1_Start
    
    subgraph P1["PHASE 1: PHÂN CÔNG RA ĐỀ THI"]
        direction TB
        
        P1_Start["PDT kiểm tra Timeline<br/>ACTOR: Phòng Đào tạo<br/>INPUT: Timeline từ Phase 0"]
        
        P1_Start --> P1_Time_Check{Đã tới thời điểm<br/>phân công?}
        P1_Time_Check -->|Chưa| P1_Wait["Chờ - Countdown hiển thị trên Dashboard<br/>Gửi reminder trước 7 ngày"]
        P1_Wait --> P1_Time_Check
        
        P1_Time_Check -->|Đúng giờ| P1_Load_Data["Tự động load dữ liệu từ hệ sinh thái:<br/>FROM EDU: Danh sách môn thi + Lớp + SV<br/>FROM HRMS: GV available + Chuyên môn<br/>FROM LMS: Outline môn học + CLO/PLO<br/>FROM OTS: Lịch sử ra đề của GV"]
        
        P1_Load_Data --> P1_Data_Valid{Kiểm tra<br/>tính đầy đủ}
        
        P1_Data_Valid -->|Thiếu dữ liệu| P1_Missing["⚠️ EDGE CASE: Dữ liệu thiếu<br/>- EDU chưa có lớp/môn<br/>- HRMS thiếu info GV<br/>- LMS chưa cập nhật CLO"]
        P1_Missing --> P1_Alert_Missing["Alert tới:<br/>→ PDT: Danh sách dữ liệu thiếu<br/>→ Đơn vị liên quan: Yêu cầu bổ sung<br/>→ Deadline bổ sung: 3 ngày"]
        P1_Alert_Missing --> P1_Manual_Input["PDT nhập bổ sung thủ công<br/>hoặc chờ đơn vị cập nhật"]
        P1_Manual_Input --> P1_Load_Data
        
        P1_Data_Valid -->|Đầy đủ| P1_AI_Match["AI phân tích & đề xuất phân công:<br/>LOGIC:<br/>- Matching GV - Môn (theo chuyên môn)<br/>- Cân bằng tải công việc GV<br/>- Ưu tiên GV đã dạy môn<br/>- Tránh conflict lịch GV<br/>- Kiểm tra năng lực (từ đánh giá trước)<br/>OUTPUT: Ma trận GV-Môn + Score matching"]
        
        P1_AI_Match --> P1_Review_BM["PDT/Trưởng khoa review đề xuất AI<br/>QUYỀN: PDT, Trưởng khoa, PGS-ĐT<br/>ACTION:<br/>- Xem chi tiết matching score<br/>- Điều chỉnh nếu cần<br/>- Thêm GV backup"]
        
        P1_Review_BM --> P1_Conflict_Check{Phát hiện<br/>conflict?}
        
        P1_Conflict_Check -->|Có| P1_Resolve_Conflict["⚠️ EDGE CASE: Xung đột phân công<br/>- GV không available (nghỉ phép/công tác)<br/>- GV quá tải (>3 môn/kỳ)<br/>- Không có GV đủ chuyên môn<br/>- GV từ chối"]
        P1_Resolve_Conflict --> P1_Solutions["Giải pháp:<br/>1. Tìm GV thay thế từ khoa khác<br/>2. Mời GV thỉnh giảng<br/>3. Phân chia nhóm GV cùng ra đề<br/>4. Báo cáo HT xin gia hạn"]
        P1_Solutions --> P1_Review_BM
        
        P1_Conflict_Check -->|Không| P1_Assign["PDT chính thức phân công:<br/>OUTPUT:<br/>- Danh sách GV + Môn phụ trách<br/>- Bộ môn phê duyệt<br/>- Deadline nộp ngân hàng câu hỏi<br/>- Deadline nộp đề thi<br/>- Số lượng đề variants (A/B/C/D)"]
        
        P1_Assign --> P1_BM_Assign["Gán Bộ môn duyệt cho từng môn<br/>LOGIC:<br/>- Bộ môn phụ trách môn học<br/>- Trưởng bộ môn + 2 GV senior<br/>OUTPUT: Committee duyệt đề"]
        
        P1_BM_Assign --> P1_Deadline_Set["Thiết lập deadline & milestones:<br/>✓ Deadline ngân hàng câu hỏi: -30 ngày<br/>✓ Deadline đề thi: -21 ngày<br/>✓ Duyệt BM: -18 ngày<br/>✓ Duyệt PKT: -15 ngày<br/>✓ Duyệt PDT: -12 ngày<br/>✓ Lập lịch: -10 ngày<br/>✓ Thi: Ngày H"]
        
        P1_Deadline_Set --> P1_Lock["🔒 KHÓA phân công<br/>- Blockchain log<br/>- Version 1.0<br/>- Chỉ PDT được sửa"]
        
        P1_Lock --> P1_Notify_All["Thông báo đa kênh:<br/>→ GV: Email + SMS + In-app notification<br/>→ Bộ môn: Dashboard + Email<br/>→ CMS: Công bố danh sách<br/>→ Calendar: Tự động tạo event + reminder<br/>CONTENT:<br/>- Môn phụ trách<br/>- Deadline chi tiết<br/>- Link hệ thống OTS<br/>- Checklist công việc"]
        
        P1_Notify_All --> P1_Track["Kích hoạt tracking system:<br/>- Countdown timer trên dashboard<br/>- Auto reminder: -7d, -3d, -1d, H-6h<br/>- Progress bar completion<br/>- Real-time status update"]
        
        P1_Track --> P1_Change_Request["⚠️ EDGE CASE: GV yêu cầu thay đổi<br/>Lý do:<br/>- Bận đột xuất<br/>- Sức khỏe<br/>- Không đủ năng lực<br/>PROCESS:<br/>→ GV gửi đơn qua OTS<br/>→ Trưởng khoa phê duyệt<br/>→ PDT tìm GV thay thế<br/>→ Update & notify"]
        
        P1_Change_Request --> P1_Monitor["PDT monitor tiến độ real-time<br/>Dashboard hiển thị:<br/>- Số GV đã nhận task<br/>- Số GV chưa confirm<br/>- Late risk alert<br/>- Completion rate"]
    end


    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    %% PHASE 2: TẠO NGÂN HÀNG CÂU HỎI
    %% ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    P1_Monitor --> P2_Start
    
    subgraph P2["PHASE 2: NGÂN HÀNG CÂU HỎI"]
        direction TB
        
        P2_Start["GV truy cập module Ngân hàng Câu hỏi<br/>ACTOR: Giảng viên<br/>INPUT: Danh sách môn được phân công"]
        
        P2_Start --> P2_Auth["Xác thực & phân quyền<br/>SSO Login"]
        
        P2_Auth --> P2_Permission{Kiểm tra<br/>quyền truy cập}
        
        P2_Permission -->|Không có quyền| P2_403["❌ EDGE CASE: Không có quyền<br/>Lý do:<br/>- Chưa được phân công<br/>- Đã bị thu hồi quyền<br/>- Sai role trong HRMS<br/>→ Liên hệ PDT"]
        
        P2_Permission -->|Có quyền| P2_Dashboard["Dashboard GV hiển thị:<br/>✓ Danh sách môn phụ trách<br/>✓ Deadline từng môn<br/>✓ Trạng thái: Chưa bắt đầu/Đang làm/Hoàn thành<br/>✓ Progress: X/100 câu<br/>✓ Countdown timer<br/>✓ Lịch sử câu hỏi cũ (nếu có)"]
        
        P2_Dashboard --> P2_Select_Subject["GV chọn môn học để tạo câu hỏi<br/>Click vào môn → Mở workspace"]
        
        P2_Select_Subject --> P2_Method{Chọn phương thức<br/>tạo câu hỏi}
        
        %% ===== AI PATH =====
        P2_Method -->|AI-Assisted| P2_AI_Start["Chọn: Tạo câu hỏi bằng AI<br/>QUYỀN: Tất cả GV"]
        
        P2_AI_Start --> P2_AI_Source{Chọn nguồn<br/>tài liệu}
        
        P2_AI_Source -->|Upload| P2_Upload["Upload tài liệu:<br/>- PDF/DOCX/PPT (giáo trình)<br/>- Size max: 50MB<br/>- Multi-file: Có<br/>VALIDATE:<br/>- Scan virus<br/>- Check format<br/>- Extract text"]
        
        P2_AI_Source -->|Sync LMS| P2_LMS_Sync["Đồng bộ từ LMS:<br/>AUTO FETCH:<br/>- Slide bài giảng<br/>- Tài liệu đọc<br/>- Video transcript<br/>- Assignment<br/>CHECK: GV có quyền truy cập LMS?"]
        
        P2_Upload --> P2_LMS_Check
        P2_LMS_Sync --> P2_LMS_Check{Có tài liệu<br/>từ LMS?}
        
        P2_LMS_Check -->|Không| P2_LMS_Error["⚠️ EDGE CASE: Không có tài liệu LMS<br/>Lý do:<br/>- GV chưa upload lên LMS<br/>- Quyền truy cập bị từ chối<br/>- LMS đang bảo trì<br/>→ Fallback: Upload thủ công"]
        P2_LMS_Error --> P2_Upload
        
        P2_LMS_Check -->|Có| P2_AI_Config["Cấu hình AI Generation:<br/>INPUT từ GV:<br/>- Số lượng câu: 100-200 (default: 150)<br/>- Phân bố Bloom:<br/>  + Remember: 20%<br/>  + Understand: 30%<br/>  + Apply: 30%<br/>  + Analyze: 15%<br/>  + Evaluate: 5%<br/>- Độ khó: Easy/Medium/Hard (30/50/20)<br/>- Ngôn ngữ: Tiếng Việt/English<br/>- CLO coverage: Auto-map từ outline"]
        
        P2_AI_Config --> P2_AI_Generate["AI xử lý & generate:<br/>PROCESS:<br/>1. Phân tích tài liệu (NLP)<br/>2. Extract key concepts<br/>3. Map với CLO/PLO từ outline<br/>4. Generate MCQ theo matrix<br/>5. Auto-tag: CLO, PLO, Bloom, Difficulty<br/>6. Check grammar & clarity<br/>7. Tạo đáp án + Giải thích<br/>OUTPUT: 150 câu MCQ với metadata đầy đủ<br/>TIME: ~3-5 phút"]
        
        P2_AI_Generate --> P2_AI_Error{Kiểm tra<br/>kết quả AI}
        
        P2_AI_Error -->|Lỗi| P2_AI_Fail["⚠️ EDGE CASE: AI generation fail<br/>Lý do:<br/>- Tài liệu không đủ nội dung<br/>- Format không đọc được<br/>- AI service downtime<br/>- Timeout<br/>→ Retry hoặc chuyển Manual"]
        P2_AI_Fail --> P2_Method
        
        P2_AI_Error -->|Thành công| P2_AI_Preview["GV xem preview 150 câu AI tạo:<br/>DISPLAY:<br/>- Câu hỏi + 4 đáp án<br/>- Đáp án đúng (highlight)<br/>- Giải thích<br/>- Tags: CLO, PLO, Bloom, Độ khó<br/>- Distribution chart (Bloom/CLO/Difficulty)<br/>ANALYTICS:<br/>- Coverage CLO: X%<br/>- Balance Bloom taxonomy<br/>- Quality score: AI confidence"]
        
        P2_AI_Preview --> P2_AI_Review["GV review từng câu:<br/>ACTION:<br/>✓ Chấp nhận (Accept)<br/>✗ Loại bỏ (Reject)<br/>✎ Chỉnh sửa (Edit)<br/>FILTER:<br/>- Theo CLO/PLO<br/>- Theo Bloom level<br/>- Theo độ khó<br/>- Theo quality score"]
        
        P2_AI_Review --> P2_AI_Select["GV chọn 100/150 câu tốt nhất<br/>SYSTEM gợi ý:<br/>- Top 100 câu quality cao<br/>- Balance distribution<br/>- Cover hết CLO<br/>GV có thể override"]
        
        P2_AI_Select --> P2_AI_Edit["GV edit câu hỏi đã chọn (optional):<br/>- Sửa wording<br/>- Đổi đáp án<br/>- Thêm hình ảnh/công thức<br/>- Cập nhật giải thích<br/>AI assist real-time:<br/>- Grammar check<br/>- Duplicate detection<br/>- Suggest improvement"]
        
        %% ===== MANUAL PATH =====
        P2_Method -->|Manual| P2_Manual_Start["Chọn: Nhập thủ công<br/>QUYỀN: Tất cả GV"]
        
        P2_Manual_Start --> P2_Manual_Form["Form nhập câu hỏi:<br/>REQUIRED FIELDS:<br/>- Nội dung câu hỏi (text/HTML)<br/>- 4 đáp án (A/B/C/D)<br/>- Đáp án đúng (single/multiple)<br/>- CLO/PLO (dropdown)<br/>- Bloom taxonomy (dropdown)<br/>- Độ khó (Easy/Medium/Hard)<br/>- Giải thích (optional)<br/>OPTIONAL:<br/>- Hình ảnh/Sơ đồ<br/>- Công thức LaTeX<br/>- Audio/Video clip"]
        
        P2_Manual_Form --> P2_Manual_Validate["AI Assist real-time:<br/>✓ Kiểm tra chính tả/ngữ pháp<br/>✓ Phát hiện câu trùng lặp<br/>✓ Đề xuất CLO/PLO phù hợp<br/>✓ Đánh giá độ khó tự động<br/>✓ Cảnh báo nếu thiếu field<br/>✓ Check đáp án logic"]
        
        P2_Manual_Validate --> P2_Manual_Save["GV lưu từng câu<br/>Status: DRAFT<br/>Có thể quay lại edit sau"]
        
        P2_Manual_Save --> P2_Manual_Progress{Đã đủ<br/>100 câu?}
        P2_Manual_Progress -->|Chưa| P2_Manual_Continue["Tiếp tục nhập<br/>Progress bar: X/100"]
        P2_Manual_Continue --> P2_Manual_Form
        
        %% ===== IMPORT PATH =====
        P2_Method -->|Import Excel| P2_Import["Import từ Excel template:<br/>DOWNLOAD template chuẩn<br/>UPLOAD file đã điền<br/>VALIDATE:<br/>- Check format<br/>- Required fields<br/>- Data type<br/>- Duplicate"]
        
        P2_Import --> P2_Import_Valid{Kiểm tra<br/>file import}
        P2_Import_Valid -->|Lỗi| P2_Import_Error["⚠️ EDGE CASE: Import lỗi<br/>- Sai format Excel<br/>- Thiếu cột bắt buộc<br/>- Data invalid<br/>- Duplicate câu hỏi<br/>→ Hiển thị chi tiết lỗi<br/>→ Download error report"]
        P2_Import_Error --> P2_Import
        P2_Import_Valid -->|OK| P2_Manual_Validate
        
        %% ===== COMMON VALIDATION =====
        P2_AI_Edit --> P2_Common_Validate
        P2_Manual_Progress -->|Đủ| P2_Common_Validate
        
