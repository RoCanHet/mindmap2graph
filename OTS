        P0_Sync_Facilities["Đồng bộ cơ sở vật chất từ EDU<br/>✓ Danh sách phòng thi<br/>✓ Sức chứa/Thiết bị<br/>✓ Trạng thái phòng<br/>✓ Lịch bảo trì"]
        
        P0_Sync_Facilities --> P0_Check_Facilities{Kiểm tra phòng thi}
